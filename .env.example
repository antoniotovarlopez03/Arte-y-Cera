# Copia este archivo como .env.local y rellena los valores.
# .env.local NO se sube al repositorio (está en .gitignore).

# Clave de Resend, el servicio que envía el formulario de contacto.
# Se saca en https://resend.com → API Keys.
# Sin esta clave la web funciona, pero el formulario avisa de que no puede
# enviar y ofrece WhatsApp y correo en su lugar (nunca finge un envío correcto).
RESEND_API_KEY=

# Remitente de los avisos. El dominio tiene que estar verificado en Resend
# (añadiendo sus registros SPF y DKIM en el DNS de OVH).
CONTACTO_REMITENTE="Web Arte y Cera <web@arteycera.es>"

# Buzón que recibe los mensajes del formulario.
CONTACTO_DESTINO=contacto@arteycera.es
